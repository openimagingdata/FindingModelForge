# Application Configuration
APP_NAME="FastAPI Starter"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT="development"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Security Configuration
SECRET_KEY="your-secret-key-here-replace-with-random-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth Configuration
# Get these from: https://github.com/settings/applications/new
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Application URLs
BASE_URL="http://localhost:8000"

# Proxy Configuration
# IPs allowed to send proxy headers (X-Forwarded-Proto, etc.)
# Use "*" to trust all IPs, or specify your proxy IPs: "172.18.0.1,10.0.0.1"
FORWARDED_ALLOW_IPS="*"

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="findingmodels"

# FindingModel DuckDB Configuration (optional)
# Specify absolute paths to pre-built DuckDB database files
# If not set, findingmodel will use platform-specific default locations
# DUCKDB_INDEX_PATH=/mnt/findingmodel/finding_models.duckdb
# DUCKDB_ANATOMIC_PATH=/mnt/findingmodel/anatomic_locations.duckdb

# FindingModel Data Directory (optional, for development)
# Override the default platform-specific location for DuckDB files
# Default on macOS: ~/Library/Application Support/findingmodel
# Default on Linux: ~/.local/share/findingmodel
# FINDINGMODEL_DATA_DIR=/custom/path/to/findingmodel
