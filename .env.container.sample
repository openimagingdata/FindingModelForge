# Container environment configuration
# Copy this file to .env.container and fill in your values

# GitHub OAuth (required for authentication)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OpenAI API (required for AI features)
OPENAI_API_KEY=sk-your-openai-api-key

# Service connections (host.docker.internal reaches services on your Mac)
REDIS_HOST=host.docker.internal
MONGODB_URI=mongodb://host.docker.internal:27017

# DuckDB paths (mounted from host via -v flag)
DUCKDB_INDEX_PATH=/mnt/findingmodel/finding_models.duckdb
DUCKDB_ANATOMIC_PATH=/mnt/findingmodel/anatomic_locations.duckdb
