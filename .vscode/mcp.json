{
  "servers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
          "--from",
         "git+https://github.com/oraios/serena",
         "serena",
         "start-mcp-server",
         "--context",
         "ide-assistant",
         "--project",
         "."
       ]
    },
    "mongodb": {
      "type": "stdio",
      "command": "npx",
      "args": ["mongodb-mcp-server@latest"],
      "env": {
        "MONGODB_URI": "mongodb://localhost:27017/findingmodels"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}
