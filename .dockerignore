# Docker build exclusions

# Python cache and artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# Git and development files
.git/
.gitignore
.dockerignore
Dockerfile*
README.md
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment files
.env
.env.*
!.env.example

# Development directories (not needed in production)
tests/
docs/
scripts/
plans/
zOld/

# Node.js (excluding lock file since we need it for reproducible builds)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend build files we need:
# - package.json and package-lock.json (for npm ci)
# - src/ directory (source files for Vite)
# - vite.config.js (Vite configuration)

# Build artifacts
dist/
build/
*.log
tmp/
temp/
htmlcov/

# Task runner files
Taskfile.yml
