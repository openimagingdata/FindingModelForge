{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "."
      ],
      "env": {}
    }
  },
  "perplexity-mcp": {
    "env": {
      "PERPLEXITY_API_KEY": "",
      "PERPLEXITY_MODEL": "sonar-reasoning-pro"
    },
    "command": "uvx",
    "args": ["perplexity-mcp"]
  },
  "mongodb": {
    "type": "stdio",
    "command": "npx",
    "args": ["mongodb-mcp-server@latest"],
    "env": {
      "MONGODB_URI": "mongodb://localhost:27017/findingmodels"
    }
  }
}
